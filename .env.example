# ===============================
# GCP Configuration
# ===============================
GCP_REGION=us-east-1
GCP_ACCOUNT_ID=123456789012
GCP_ACCESS_KEY_ID=your_access_key
GCP_SECRET_ACCESS_KEY=your_secret_key

# ===============================
# Project Configuration
# ===============================
PROJECT_NAME=financial-data-pipeline
ENVIRONMENT=dev
DEPLOYMENT_TIMESTAMP=

# ===============================
# Financial APIs
# ===============================
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FRED_API_KEY=your_fred_api_key
YAHOO_FINANCE_TIMEOUT=30

# ===============================
# GCS Configuration
# ===============================
GCS_BUCKET_RAW_DATA=financial-data-raw-dev
GCS_BUCKET_PROCESSED_DATA=financial-data-processed-dev
GCS_BUCKET_LOGS=financial-data-logs-dev
GCS_BUCKET_AIRFLOW=financial-data-airflow-dev

# ===============================
# BigQuery Configuration
# ===============================
BIGQUERY_CLUSTER_IDENTIFIER=financial-data-cluster-dev
BIGQUERY_DATABASE=financial_data
BIGQUERY_HOST=your-cluster.region.bigquery.googlegcp.com
BIGQUERY_PORT=5439
BIGQUERY_USER=admin
BIGQUERY_PASSWORD=your_bigquery_password
BIGQUERY_SCHEMA_RAW=raw_data
BIGQUERY_SCHEMA_STAGING=staging
BIGQUERY_SCHEMA_MARTS=marts

# ===============================
# Airflow Configuration
# ===============================
AIRFLOW_ENVIRONMENT_NAME=financial-data-cloudcomposer-dev
AIRFLOW_GCS_BUCKET=financial-data-airflow-dev
AIRFLOW_EXECUTION_ROLE_ARN=arn:gcp:iam::123456789012:role/service-role/GoogleCloud Composer-ExecutionRole
AIRFLOW_DAG_GCS_PATH=dags/
AIRFLOW_PLUGINS_GCS_PATH=plugins/
AIRFLOW_REQUIREMENTS_GCS_PATH=requirements.txt

# ===============================
# dbt Configuration
# ===============================
DBT_PROFILES_DIR=./dbt/profiles
DBT_PROJECT_DIR=./dbt
DBT_TARGET=dev

# ===============================
# Data Sources Configuration
# ===============================
# Stock symbols to track (comma-separated)
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,NFLX,CRM,ADBE
# Sector ETFs
SECTOR_ETFS=XLK,XLV,XLF,XLI,XLE,XLP,XLY,XLU,XLB,XLRE,XLC
# Market indices
MARKET_INDICES=SPY,QQQ,DIA,IWM,VTI

# ===============================
# Pipeline Configuration
# ===============================
DATA_INGESTION_FREQUENCY=daily
DATA_RETENTION_DAYS=365
BATCH_SIZE=100
MAX_RETRIES=3
RETRY_DELAY=300

# ===============================
# Monitoring & Alerting
# ===============================
ENABLE_MONITORING=true
SLACK_WEBHOOK_URL=your_slack_webhook_url
EMAIL_NOTIFICATIONS=your_email@example.com
CLOUDWATCH_LOG_GROUP=/gcp/cloudcomposer/financial-data-pipeline
CLOUDWATCH_LOG_RETENTION_DAYS=30

# ===============================
# Data Quality
# ===============================
ENABLE_DATA_QUALITY_CHECKS=true
DATA_QUALITY_THRESHOLD=0.95
ANOMALY_DETECTION_ENABLED=true
SCHEMA_VALIDATION_ENABLED=true

# ===============================
# Security
# ===============================
ENCRYPTION_KEY=your_encryption_key_here
ENABLE_SSL=true
ENABLE_IAM_AUTHENTICATION=true

# ===============================
# Development Configuration
# ===============================
DEBUG=false
LOG_LEVEL=INFO
TESTING_MODE=false
MOCK_API_RESPONSES=false

# ===============================
# Database Connection Strings
# ===============================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://admin:password@your-cluster.region.bigquery.gcp.com:5439/financial_data

# ===============================
# Terraform Variables
# ===============================
TF_VAR_project_name=financial-data-pipeline
TF_VAR_environment=dev
TF_VAR_gcp_region=us-east-1
TF_VAR_availability_zones=["us-east-1a", "us-east-1b"]
